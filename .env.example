# Banco e credenciais dos serviços
POSTGRES_DB=obrasgov
POSTGRES_USER=obrasgov_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5434
INGESTION_PASSWORD=change-me-ingestion
DBT_PASSWORD=change-me-dbt
FRONTEND_PASSWORD=change-me-frontend
CHAT_PASSWORD=change-me-chat

# Artefatos temporários do dbt dentro do container
DBT_TARGET_PATH=/tmp/dbt-target

# Fonte e ingestão
OBRASGOV_BASE_URL=https://api-publica.obrasgov.gestao.gov.br/obras
OBRASGOV_PAGE_SIZE=200
OBRASGOV_MAX_RETRIES=3
OBRASGOV_TIMEOUT_SECONDS=120

# Aplicação Streamlit
STREAMLIT_PORT=8501

# Chat analítico (desabilitado por padrão)
ANALYTICAL_CHAT_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# URL para execução do frontend fora do Compose; o Compose monta a URL interna.
GOLD_CHAT_DATABASE_URL=postgresql://obrasgov_chat:change-me-chat@127.0.0.1:5434/obrasgov
