POSTGRES_DB=obrasgov
POSTGRES_USER=obrasgov_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5434
INGESTION_PASSWORD=change-me-ingestion
DBT_PASSWORD=change-me-dbt
# Diretório interno do container para artefatos temporários do dbt.
DBT_TARGET_PATH=/tmp/dbt-target
FRONTEND_PASSWORD=change-me-frontend
CHAT_PASSWORD=change-me-chat
OBRASGOV_BASE_URL=https://api-publica.obrasgov.gestao.gov.br/obras
OBRASGOV_PAGE_SIZE=200
OBRASGOV_MAX_RETRIES=3
OBRASGOV_TIMEOUT_SECONDS=120
STREAMLIT_PORT=8501

# SPEC-003 — chat analítico (desabilitado por padrão)
ANALYTICAL_CHAT_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANALYTICAL_CHAT_PROVIDER_TIMEOUT_SECONDS=30
ANALYTICAL_CHAT_MAX_QUESTION_CHARS=4000
ANALYTICAL_CHAT_MAX_RESULT_ROWS=100
ANALYTICAL_CHAT_MAX_RESULT_COLUMNS=20
ANALYTICAL_CHAT_MAX_RESULT_BYTES=32000
ANALYTICAL_CHAT_MAX_CELL_CHARS=1000
ANALYTICAL_CHAT_STATEMENT_TIMEOUT_MS=5000
ANALYTICAL_CHAT_MAX_ROWS=100
ANALYTICAL_CHAT_MAX_COLUMNS=20
ANALYTICAL_CHAT_MAX_CELLS=2000
ANALYTICAL_CHAT_MAX_BYTES=1048576
